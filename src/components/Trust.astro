---
/**
 * Trust.astro
 * Social proof — stats block + optional testimonial.
 * FR-TRUST-01 → 03 | See docs/03-WIREFRAMES.md W7
 */
import type { Lang } from '../utils/i18n'
import { t, tObjectArray } from '../utils/i18n'

interface Props {
  lang: Lang
}

interface Stat {
  value: string
  label: string
}

const { lang } = Astro.props

const stats = tObjectArray<Stat>(lang, 'trust.stats')
---

<section id="trust" class="trust section" aria-label={t(lang, 'trust.headline')}>
  <div class="container">

    <div class="trust__header">
      <span class="section-label reveal" data-i18n="trust.label">{t(lang, 'trust.label')}</span>
      <h2 class="trust__headline reveal stagger-1" data-i18n="trust.headline">{t(lang, 'trust.headline')}</h2>
    </div>

    <!-- Stats block -->
    <div class="trust__stats" role="list" aria-label={lang === 'fr' ? 'Chiffres clés' : 'Key figures'}>
      {stats.map((stat, i) => (
        <div class={`trust__stat reveal stagger-${i + 1}`} role="listitem">
          <span class="trust__stat-value" data-i18n={`trust.stats.${i}.value`}>{stat.value}</span>
          <span class="trust__stat-label" data-i18n={`trust.stats.${i}.label`}>{stat.label}</span>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .trust {
    background: var(--color-black);
    border-top: 1px solid var(--color-border);
  }

  .trust__header {
    margin-bottom: var(--space-10);
  }

  .trust__headline {
    font-family: var(--font-display);
    font-size: var(--text-h1);
    font-weight: 800;
    line-height: var(--text-h1-lh);
    letter-spacing: var(--text-h1-ls);
    color: var(--color-cream);
  }

  /* Stats */
  .trust__stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-8);
    margin-bottom: var(--space-10);
  }

  .trust__stat {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .trust__stat-value {
    font-family: var(--font-display);
    font-size: clamp(3rem, 7vw, 6rem);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--color-yellow);
  }

  .trust__stat-label {
    font-family: var(--font-display);
    font-size: var(--text-label);
    font-weight: 400;
    letter-spacing: var(--text-label-ls);
    text-transform: uppercase;
    color: var(--color-gray-400);
  }

  /* Responsive */
  @media (min-width: 768px) and (max-width: 1199px) {
    .trust__stats {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 767px) {
    .trust__stats {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-6);
    }
  }
</style>
