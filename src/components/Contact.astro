---
/**
 * Contact.astro
 * Full contact section — left info column + right form.
 * FR-CONT-01 → 12 | See docs/08-CONTACT-SPEC.md
 *
 * This component renders as a static shell.
 * The interactive form logic is in the <script> block below.
 * No JS framework required — native browser APIs only.
 */
import type { Lang } from '../utils/i18n'
import { t } from '../utils/i18n'

interface Props {
  lang: Lang
}

const { lang } = Astro.props

const subjects = [
  { key: 'migration' },
  { key: 'fico' },
  { key: 'mco' },
  { key: 'audit' },
  { key: 'other' },
]
---

<section id="contact" class="contact section" aria-label={t(lang, 'contact.headline')}>
  <div class="container">
    <div class="contact__grid">

      <!-- LEFT — context copy + direct contact -->
      <div class="contact__info">
        <span class="section-label reveal" data-i18n="contact.label">{t(lang, 'contact.label')}</span>

        <h2 class="contact__headline reveal stagger-1" data-i18n="contact.headline">
          {t(lang, 'contact.headline')}
        </h2>

        <p class="contact__sub reveal stagger-2" data-i18n="contact.subheadline">
          {t(lang, 'contact.subheadline')}
        </p>

        <!-- Divider -->
        <div class="contact__info-divider" aria-hidden="true"></div>

        <!-- Direct contact info -->
        <ul class="contact__direct" role="list">
          <li class="contact__direct-item reveal stagger-3">
            <svg class="contact__direct-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
            <div>
              <span class="contact__direct-label" data-i18n="contact.direct.email_label">{t(lang, 'contact.direct.email_label')}</span>
              <a
                href={`mailto:${t(lang, 'contact.direct.email')}`}
                class="contact__direct-value"
                title="Envoyer un e-mail"
              >
                {t(lang, 'contact.direct.email')}
              </a>
            </div>
          </li>

          <li class="contact__direct-item reveal stagger-4">
            <svg class="contact__direct-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2.18h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            <div>
              <span class="contact__direct-label" data-i18n="contact.direct.phone_label">{t(lang, 'contact.direct.phone_label')}</span>
              <a
                href={`tel:${t(lang, 'contact.direct.phone').replace(/\s/g, '')}`}
                class="contact__direct-value"
                title="Appeler"
              >
                {t(lang, 'contact.direct.phone')}
              </a>
            </div>
          </li>

          <li class="contact__direct-item reveal stagger-5">
            <svg class="contact__direct-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/>
            </svg>
            <div>
              <span class="contact__direct-label" data-i18n="contact.direct.linkedin_label">{t(lang, 'contact.direct.linkedin_label')}</span>
              <a
                href={t(lang, 'contact.direct.linkedin')}
                class="contact__direct-value"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="LinkedIn (opens in new tab)"
              >
                LinkedIn →
              </a>
            </div>
          </li>

          <li class="contact__direct-item reveal stagger-5">
            <svg class="contact__direct-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/>
            </svg>
            <span class="contact__direct-value" data-i18n="contact.direct.location">{t(lang, 'contact.direct.location')}</span>
          </li>

          <li class="contact__direct-item contact__direct-item--accent reveal stagger-5">
            <svg class="contact__direct-icon contact__direct-icon--accent" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/>
            </svg>
            <span class="contact__direct-value contact__direct-value--accent" data-i18n="contact.direct.response_time">
              {t(lang, 'contact.direct.response_time')}
            </span>
          </li>
        </ul>
      </div>

      <!-- RIGHT — form -->
      <div class="contact__form-col">

        <!-- aria-live region for error announcements -->
        <div
          id="form-announcer"
          class="sr-only"
          aria-live="polite"
          aria-atomic="true"
        ></div>

        <!-- SUCCESS state (hidden until submission) -->
        <div id="form-success" class="form-success" hidden aria-labelledby="success-headline">
          <div class="form-success__inner">
            <!-- Animated SVG checkmark -->
            <svg class="form-success__check" viewBox="0 0 52 52" fill="none" aria-hidden="true">
              <circle class="form-success__circle" cx="26" cy="26" r="23" stroke="#FCD405" stroke-width="2"/>
              <path class="form-success__tick" d="M14 26l8 8 16-16" stroke="#FCD405" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <h3 id="success-headline" class="form-success__headline" tabindex="-1" data-i18n="contact.success.headline">
              {t(lang, 'contact.success.headline')}
            </h3>
            <p class="form-success__body" data-i18n="contact.success.body">{t(lang, 'contact.success.body')}</p>
          </div>
        </div>

        <!-- FORM -->
        <form
          id="contact-form"
          class="form"
          novalidate
          data-lang={lang}
        >
          <!-- Honeypot (anti-spam) -->
          <input
            type="text"
            name="_trap"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
            style="position:absolute;left:-9999px;opacity:0;pointer-events:none;"
          />

          <!-- Subject chips -->
          <fieldset class="form__fieldset">
            <legend class="form-label" data-i18n="contact.form.subject_label">{t(lang, 'contact.form.subject_label')}</legend>
            <div
              class="chips"
              role="listbox"
              aria-label={t(lang, 'contact.form.subject_label')}
              id="chips-container"
              data-i18n-al="contact.form.subject_label"
            >
              {subjects.map(({ key }) => (
                <button
                  type="button"
                  class="chip"
                  role="option"
                  aria-selected="false"
                  data-subject-key={key}
                  data-subject-value={t(lang, `contact.subjects.${key}`)}
                  data-i18n={`contact.subjects.${key}`}
                >
                  {t(lang, `contact.subjects.${key}`)}
                </button>
              ))}
            </div>
            <div id="subject-error" class="form-error" role="alert" hidden></div>
          </fieldset>

          <!-- 2-col row: Name + Company -->
          <div class="form__row">
            <div class="form-field">
              <label class="form-label" for="contact-name">
                <span data-i18n="contact.form.name_label">{t(lang, 'contact.form.name_label')}</span>
                <span class="form__required" aria-label="requis">*</span>
              </label>
              <input
                type="text"
                id="contact-name"
                name="name"
                class="form-input"
                placeholder={t(lang, 'contact.form.name_placeholder')}
                data-i18n-ph="contact.form.name_placeholder"
                autocomplete="name"
                required
                aria-required="true"
                aria-describedby="name-error"
              />
              <div id="name-error" class="form-error" role="alert" hidden></div>
            </div>

            <div class="form-field">
              <label class="form-label" for="contact-company">
                <span data-i18n="contact.form.company_label">{t(lang, 'contact.form.company_label')}</span>
                <span class="form__required" aria-label="requis">*</span>
              </label>
              <input
                type="text"
                id="contact-company"
                name="company"
                class="form-input"
                placeholder={t(lang, 'contact.form.company_placeholder')}
                data-i18n-ph="contact.form.company_placeholder"
                autocomplete="organization"
                required
                aria-required="true"
                aria-describedby="company-error"
              />
              <div id="company-error" class="form-error" role="alert" hidden></div>
            </div>
          </div>

          <!-- 2-col row: Email + Phone -->
          <div class="form__row">
            <div class="form-field">
              <label class="form-label" for="contact-email">
                <span data-i18n="contact.form.email_label">{t(lang, 'contact.form.email_label')}</span>
                <span class="form__required" aria-label="requis">*</span>
              </label>
              <input
                type="email"
                id="contact-email"
                name="email"
                class="form-input"
                placeholder={t(lang, 'contact.form.email_placeholder')}
                data-i18n-ph="contact.form.email_placeholder"
                autocomplete="email"
                required
                aria-required="true"
                aria-describedby="email-error"
              />
              <div id="email-error" class="form-error" role="alert" hidden></div>
            </div>

            <div class="form-field">
              <label class="form-label" for="contact-phone">
                <span data-i18n="contact.form.phone_label">{t(lang, 'contact.form.phone_label')}</span>
              </label>
              <input
                type="tel"
                id="contact-phone"
                name="phone"
                class="form-input"
                placeholder={t(lang, 'contact.form.phone_placeholder')}
                data-i18n-ph="contact.form.phone_placeholder"
                autocomplete="tel"
              />
            </div>
          </div>

          <!-- Message -->
          <div class="form-field">
            <label class="form-label" for="contact-message">
              <span data-i18n="contact.form.message_label">{t(lang, 'contact.form.message_label')}</span>
              <span class="form__required" aria-label="requis">*</span>
            </label>
            <textarea
              id="contact-message"
              name="message"
              class="form-input form-input--textarea"
              rows="5"
              placeholder={t(lang, 'contact.form.message_placeholder')}
              data-i18n-ph="contact.form.message_placeholder"
              required
              aria-required="true"
              aria-describedby="message-error"
            ></textarea>
            <div id="message-error" class="form-error" role="alert" hidden></div>
          </div>

          <!-- GDPR consent -->
          <div class="form__gdpr">
            <div class="gdpr-field">
              <input
                type="checkbox"
                id="contact-gdpr"
                name="gdpr"
                class="gdpr-checkbox"
                required
                aria-required="true"
                aria-describedby="gdpr-error"
              />
              <label class="gdpr-label" for="contact-gdpr">
                <span data-i18n="contact.form.gdpr_label">{t(lang, 'contact.form.gdpr_label')}</span>
                {' '}
                <a
                  href={t(lang, 'contact.form.gdpr_link_href')}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="gdpr-link"
                  data-i18n="contact.form.gdpr_link_text"
                >
                  {t(lang, 'contact.form.gdpr_link_text')}
                </a>
              </label>
            </div>
            <div id="gdpr-error" class="form-error" role="alert" hidden></div>
          </div>

          <!-- API error banner -->
          <div id="api-error" class="api-error" role="alert" hidden></div>

          <!-- Submit -->
          <div class="form__submit-row">
            <button
              type="submit"
              id="form-submit"
              class="btn-primary form__submit-btn"
            >
              <span id="submit-label" data-i18n="contact.form.submit">{t(lang, 'contact.form.submit')}</span>
              →
            </button>
          </div>
        </form>

      </div>
    </div>
  </div>
</section>

<script>
  import { t } from '../utils/i18n'
  import type { Lang } from '../utils/i18n'

  // ---------------------------------------------------------------------------
  // DOM refs
  // ---------------------------------------------------------------------------
  const form        = document.getElementById('contact-form') as HTMLFormElement
  const successEl   = document.getElementById('form-success') as HTMLElement
  const announcer   = document.getElementById('form-announcer') as HTMLElement
  const submitBtn   = document.getElementById('form-submit') as HTMLButtonElement
  const submitLabel = document.getElementById('submit-label') as HTMLElement
  const apiErrorEl  = document.getElementById('api-error') as HTMLElement
  const chips       = document.querySelectorAll<HTMLButtonElement>('.chip')

  // lang is kept as a mutable variable so it stays in sync when the user
  // switches language. The global applyTranslations() in BaseLayout updates
  // form.dataset.lang first, then dispatches 'fixis:lang-change'.
  let lang: Lang = (form?.dataset.lang as Lang) ?? 'fr'

  // Keep lang in sync whenever the user switches language
  window.addEventListener('fixis:lang-change', (e) => {
    const newLang = (e as CustomEvent<{ lang: Lang }>).detail.lang
    lang = newLang

    // Update data-subject-value on each chip so selected subject reflects new lang
    chips.forEach((chip) => {
      const subjectKey = chip.dataset.subjectKey
      if (subjectKey) {
        const newValue = t(newLang, `contact.subjects.${subjectKey}`)
        chip.dataset.subjectValue = newValue
        // If this chip is currently selected, update selectedSubject too
        if (chip.getAttribute('aria-selected') === 'true') {
          selectedSubject = newValue
        }
      }
    })
  })

  let selectedSubject = ''

  // ---------------------------------------------------------------------------
  // Subject chips
  // ---------------------------------------------------------------------------
  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      chips.forEach((c) => c.setAttribute('aria-selected', 'false'))
      chip.setAttribute('aria-selected', 'true')
      selectedSubject = chip.dataset.subjectValue ?? ''
      clearError('subject')
    })

    chip.addEventListener('keydown', (e) => {
      const chipsArr = Array.from(chips)
      const idx = chipsArr.indexOf(chip)
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
        e.preventDefault()
        chipsArr[(idx + 1) % chipsArr.length]?.focus()
      }
      if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
        e.preventDefault()
        chipsArr[(idx - 1 + chipsArr.length) % chipsArr.length]?.focus()
      }
    })
  })

  // ---------------------------------------------------------------------------
  // Validation helpers
  // ---------------------------------------------------------------------------
  function showError(fieldId: string, message: string) {
    const errorEl = document.getElementById(`${fieldId}-error`)
    const inputEl = document.getElementById(`contact-${fieldId}`) ??
                    document.getElementById('chips-container')
    if (errorEl) {
      errorEl.textContent = message
      errorEl.removeAttribute('hidden')
    }
    if (inputEl) inputEl.classList.add('error')
  }

  function clearError(fieldId: string) {
    const errorEl = document.getElementById(`${fieldId}-error`)
    const inputEl = document.getElementById(`contact-${fieldId}`) ??
                    document.getElementById('chips-container')
    if (errorEl) {
      errorEl.textContent = ''
      errorEl.setAttribute('hidden', '')
    }
    if (inputEl) inputEl.classList.remove('error')
  }

  function validate(data: Record<string, string | boolean>): boolean {
    let valid = true

    if (!String(data.name).trim()) {
      showError('name', t(lang, 'contact.errors.name_required'))
      valid = false
    } else clearError('name')

    if (!String(data.company).trim()) {
      showError('company', t(lang, 'contact.errors.company_required'))
      valid = false
    } else clearError('company')

    if (!String(data.email).trim()) {
      showError('email', t(lang, 'contact.errors.email_required'))
      valid = false
    } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(String(data.email))) {
      showError('email', t(lang, 'contact.errors.email_invalid'))
      valid = false
    } else clearError('email')

    if (!selectedSubject) {
      showError('subject', t(lang, 'contact.errors.subject_required'))
      valid = false
    } else clearError('subject')

    if (!String(data.message).trim()) {
      showError('message', t(lang, 'contact.errors.message_required'))
      valid = false
    } else clearError('message')

    if (!data.gdpr) {
      showError('gdpr', t(lang, 'contact.errors.gdpr_required'))
      valid = false
    } else clearError('gdpr')

    return valid
  }

  // ---------------------------------------------------------------------------
  // Auto-expand textarea
  // ---------------------------------------------------------------------------
  const textarea = document.getElementById('contact-message') as HTMLTextAreaElement
  if (textarea) {
    textarea.addEventListener('input', () => {
      textarea.style.height = 'auto'
      const maxH = parseInt(getComputedStyle(textarea).lineHeight) * 10
      textarea.style.height = Math.min(textarea.scrollHeight, maxH) + 'px'
    })
  }

  // ---------------------------------------------------------------------------
  // Clear errors on input blur
  // ---------------------------------------------------------------------------
  ;['name', 'company', 'email', 'message'].forEach((field) => {
    const el = document.getElementById(`contact-${field}`)
    el?.addEventListener('blur', () => {
      const val = (el as HTMLInputElement).value
      if (val.trim()) clearError(field)
    })
  })

  // ---------------------------------------------------------------------------
  // Form submission
  // ---------------------------------------------------------------------------
  form?.addEventListener('submit', async (e) => {
    e.preventDefault()

    const fd = new FormData(form)
    const data = {
      name:    fd.get('name')    as string,
      company: fd.get('company') as string,
      email:   fd.get('email')   as string,
      phone:   fd.get('phone')   as string,
      subject: selectedSubject,
      message: fd.get('message') as string,
      gdpr:    fd.has('gdpr'),
      _trap:   fd.get('_trap')   as string,
    }

    // Honeypot: silently ignore bots
    if (data._trap) return

    if (!validate(data)) {
      // Announce errors to screen readers
      announcer.textContent = lang === 'fr'
        ? 'Des erreurs ont été trouvées dans le formulaire.'
        : 'There are errors in the form. Please review and correct them.'
      return
    }

    // SUBMITTING state
    submitBtn.disabled = true
    submitLabel.textContent = t(lang, 'contact.form.submit_loading')
    apiErrorEl.setAttribute('hidden', '')
    form.style.opacity = '0.6'
    form.style.pointerEvents = 'none'

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      })

      if (!res.ok) throw new Error('API_ERROR')

      // SUCCESS
      form.setAttribute('hidden', '')
      successEl.removeAttribute('hidden')
      const successHeadline = document.getElementById('success-headline')
      successHeadline?.focus()
      announcer.textContent = t(lang, 'contact.success.body')

    } catch {
      // ERROR state
      form.style.opacity = ''
      form.style.pointerEvents = ''
      submitBtn.disabled = false
      submitLabel.textContent = t(lang, 'contact.form.submit')

      apiErrorEl.textContent = t(lang, 'contact.errors.api_failure')
      apiErrorEl.removeAttribute('hidden')
      apiErrorEl.focus()
      announcer.textContent = t(lang, 'contact.errors.api_failure')

      // Auto-dismiss after 8s
      setTimeout(() => apiErrorEl.setAttribute('hidden', ''), 8000)
    }
  })
</script>

<style>
  .contact {
    background: var(--color-black);
    border-top: 1px solid var(--color-border);
    min-height: 100svh;
    display: flex;
    align-items: center;
  }

  .contact__grid {
    display: grid;
    grid-template-columns: 2fr 3fr;
    gap: var(--space-12);
    align-items: start;
  }

  /* Left info column */
  .contact__info {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    position: sticky;
    top: 6rem;
  }

  .contact__headline {
    font-family: var(--font-display);
    font-size: var(--text-h1);
    font-weight: 800;
    line-height: var(--text-h1-lh);
    letter-spacing: var(--text-h1-ls);
    color: var(--color-cream);
  }

  .contact__sub {
    font-family: var(--font-body);
    font-size: var(--text-body);
    line-height: var(--text-body-lh);
    color: var(--color-gray-400);
  }

  .contact__info-divider {
    height: 1px;
    background: var(--color-border);
  }

  /* Direct contact */
  .contact__direct {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .contact__direct-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .contact__direct-icon {
    color: var(--color-gray-400);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .contact__direct-icon--accent {
    color: var(--color-yellow);
  }

  .contact__direct-label {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-label);
    font-weight: 400;
    letter-spacing: var(--text-label-ls);
    text-transform: uppercase;
    color: var(--color-gray-400);
    margin-bottom: 2px;
  }

  .contact__direct-value {
    font-family: var(--font-display);
    font-size: var(--text-small);
    color: var(--color-cream);
    text-decoration: none;
    transition: color var(--duration-fast);
  }

  .contact__direct-value:hover {
    color: var(--color-yellow);
  }

  .contact__direct-value--accent {
    color: var(--color-yellow);
    font-weight: 700;
  }

  /* Form column */
  .contact__form-col {
    padding: var(--space-8);
    border: 1px solid var(--color-border);
  }

  /* Form layout */
  .form {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    transition: opacity var(--duration-medium), pointer-events var(--duration-medium);
  }

  .form__fieldset {
    border: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .form__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5);
  }

  .form__required {
    color: var(--color-yellow);
    margin-left: 2px;
  }

  .form__submit-row {
    display: flex;
    justify-content: flex-end;
    padding-top: var(--space-2);
  }

  .form__submit-btn {
    min-width: 200px;
    justify-content: space-between;
  }

  .form__submit-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
  }

  /* Textarea */
  .form-input--textarea {
    resize: none;
    min-height: 8rem;
    max-height: 20rem;
    overflow-y: auto;
  }

  /* Subject chips */
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .chips.error {
    /* highlight chips container on error */
  }

  .chip {
    padding: var(--space-2) var(--space-4);
    font-family: var(--font-display);
    font-size: var(--text-small);
    font-weight: 400;
