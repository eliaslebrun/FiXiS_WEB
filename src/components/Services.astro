---
/**
 * Services.astro
 * Services section — 4 cards grid.
 * FR-SERV-01 → 04 | See docs/03-WIREFRAMES.md W5
 */
import type { Lang } from '../utils/i18n'
import { t } from '../utils/i18n'
import ServiceCard from './ui/ServiceCard.astro'

interface Props {
  lang: Lang
}

const { lang } = Astro.props

const services = [
  { key: 's4',       staggerIndex: 1 },
  { key: 'fico',     staggerIndex: 2 },
  { key: 'mco',      staggerIndex: 3 },
  { key: 'advisory', staggerIndex: 4 },
]
---

<section id="services" class="services section" aria-label={t(lang, 'services.headline')}>
  <div class="container">
    <!-- Section header -->
    <div class="services__header">
      <span class="section-label reveal">{t(lang, 'services.label')}</span>
      <h2 class="services__headline reveal stagger-1">{t(lang, 'services.headline')}</h2>
      <p class="services__sub reveal stagger-2">{t(lang, 'services.subheadline')}</p>
    </div>

    <!-- Cards grid -->
    <div class="services__grid">
      {services.map(({ key, staggerIndex }) => (
        <ServiceCard
          number={t(lang, `services.${key}.number`)}
          title={t(lang, `services.${key}.title`)}
          description={t(lang, `services.${key}.description`)}
          staggerIndex={staggerIndex}
        />
      ))}
    </div>
  </div>
</section>

<style>
  .services {
    background: var(--color-black);
    border-top: 1px solid var(--color-border);
  }

  .services__header {
    margin-bottom: var(--space-10);
    max-width: var(--max-width-sm);
  }

  .services__headline {
    font-family: var(--font-display);
    font-size: var(--text-h1);
    font-weight: 800;
    line-height: var(--text-h1-lh);
    letter-spacing: var(--text-h1-ls);
    color: var(--color-cream);
    margin-bottom: var(--space-4);
  }

  .services__sub {
    font-family: var(--font-body);
    font-size: var(--text-body);
    line-height: var(--text-body-lh);
    color: var(--color-gray-400);
  }

  .services__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-5);
  }

  @media (min-width: 768px) and (max-width: 1199px) {
    .services__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 767px) {
    .services__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
