---
/**
 * Footer.astro
 * Site footer with legal links and language toggle.
 * See docs/03-WIREFRAMES.md W10
 */
import type { Lang } from '../utils/i18n'
import { t } from '../utils/i18n'
import LangToggle from './ui/LangToggle.astro'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const year = new Date().getFullYear()
const copyright = t(lang, 'footer.copyright').replace('{year}', String(year))
---

<footer class="footer" role="contentinfo">
  <div class="container">
    <div class="footer__inner">

      <!-- Left: brand -->
      <div class="footer__brand">
        <a href="/#hero" class="footer__logo" aria-label="FiXiS — retour à l'accueil">
          FiXiS
        </a>
        <p class="footer__tagline" data-i18n="footer.tagline">{t(lang, 'footer.tagline')}</p>
        <a href={`mailto:${t(lang, 'contact.direct.email')}`} class="footer__email">
          {t(lang, 'contact.direct.email')}
        </a>
      </div>

      <!-- Right: links -->
      <div class="footer__links">
        <nav class="footer__nav" aria-label="Liens légaux">
          <a
            href={lang === 'fr' ? '/mentions-legales' : '/legal'}
            class="footer__link"
            data-i18n="footer.legal_link"
          >
            {t(lang, 'footer.legal_link')}
          </a>
          <span class="footer__sep" aria-hidden="true">·</span>
          <a
            href={lang === 'fr' ? '/politique-confidentialite' : '/privacy'}
            class="footer__link"
            data-i18n="footer.privacy_link"
          >
            {t(lang, 'footer.privacy_link')}
          </a>
          <span class="footer__sep" aria-hidden="true">·</span>
          <LangToggle lang={lang} />
        </nav>

        <p class="footer__copy" data-i18n-copyright>{copyright}</p>
        <p class="footer__made"><span data-i18n="footer.made_with">{t(lang, 'footer.made_with')}</span> ♥</p>
      </div>

    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-near-black);
    border-top: 1px solid var(--color-border);
    padding: var(--space-10) 0 var(--space-8);
  }

  .footer__inner {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-8);
  }

  /* Brand */
  .footer__brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer__logo {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.25rem;
    letter-spacing: -0.03em;
    color: var(--color-cream);
    text-decoration: none;
  }

  .footer__tagline {
    font-family: var(--font-body);
    font-size: var(--text-small);
    font-style: italic;
    color: var(--color-gray-400);
    max-width: 32ch;
  }

  .footer__email {
    font-family: var(--font-display);
    font-size: var(--text-small);
    color: var(--color-gray-400);
    text-decoration: none;
    transition: color var(--duration-fast);
  }

  .footer__email:hover {
    color: var(--color-yellow);
  }

  /* Links */
  .footer__links {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-3);
  }

  .footer__nav {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .footer__link {
    font-family: var(--font-display);
    font-size: var(--text-small);
    font-weight: 400;
    letter-spacing: 0.02em;
    color: var(--color-gray-400);
    text-decoration: none;
    transition: color var(--duration-fast);
  }

  .footer__link:hover {
    color: var(--color-cream);
  }

  .footer__sep {
    color: var(--color-gray-700);
    font-size: var(--text-small);
  }

  .footer__copy,
  .footer__made {
    font-family: var(--font-display);
    font-size: var(--text-small);
    color: var(--color-gray-700);
    text-align: right;
  }

  @media (max-width: 767px) {
    .footer__inner {
      flex-direction: column;
      gap: var(--space-6);
    }

    .footer__links {
      align-items: flex-start;
    }

    .footer__nav {
      justify-content: flex-start;
    }

    .footer__copy,
    .footer__made {
      text-align: left;
    }
  }
</style>
