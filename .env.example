# ============================================================
# FiXiS — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to git.
# ============================================================

# Resend API key (https://resend.com)
# Required for the contact form to send emails.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# hCaptcha (https://www.hcaptcha.com) — optional, P1
# Add invisible hCaptcha for additional anti-spam protection.
HCAPTCHA_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PUBLIC_HCAPTCHA_SITEKEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
